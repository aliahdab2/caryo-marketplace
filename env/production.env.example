# ============================================================================
# Caryo Marketplace — production environment
#
# Copy to env/production.env on the server and fill in every REQUIRED value.
# env/production.env is gitignored — NEVER commit the real file.
# ============================================================================

# --- Public URL (REQUIRED) --------------------------------------------------
# The site's public origin, no trailing slash. All public links, CORS, and
# NEXT_PUBLIC_* build args derive from this.
PUBLIC_URL=https://caryo.example.com

# --- Host ports (only nginx publishes ports) --------------------------------
# Change when co-hosting with another stack (jawab24 uses 80/443 + 3000-3002;
# caryo's internal services use 3100/8080/9000 inside its own Docker network)
HTTP_PORT=80
HTTPS_PORT=443

# --- Database (REQUIRED) ----------------------------------------------------
DB_NAME=caryo
DB_USER=caryo
# Generate: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10

# --- Auth secrets (REQUIRED) ------------------------------------------------
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# --- Object storage / MinIO (REQUIRED) --------------------------------------
# Generate access key: openssl rand -hex 20 | secret: openssl rand -base64 32
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=caryo-assets

# --- TLS (recommended — see deploy/README.md) -------------------------------
# Used by scripts/deploy/issue-cert.sh to obtain a Let's Encrypt certificate,
# and as nginx's server_name once one exists. Leave empty only when TLS is
# terminated upstream (e.g. Cloudflare).
CERT_DOMAIN=caryo.example.com
CERT_EMAIL=

# --- Redis cache ------------------------------------------------------------
# The redis service is part of the stack; the backend reaches it at redis:6379.
# Only the memory ceiling is tunable here.
REDIS_MAXMEMORY=256mb

# --- Scheduled database backups ---------------------------------------------
# The db-backup service dumps to backups/ on this interval, keeping the last
# BACKUP_KEEP files. deploy.sh takes its own pre-deploy snapshot separately.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14

# --- OpenAI (optional) ------------------------------------------------------
# Only used to machine-translate car brand/model reference data into Arabic
# during seeding. Empty simply disables that feature.
OPENAI_API_KEY=

# --- imgproxy (optional; URLs are unsigned for now) -------------------------
# Generate each: xxd -g 2 -l 64 -p /dev/random | tr -d '\n'
IMGPROXY_KEY=
IMGPROXY_SALT=

# --- Email / SMTP (recommended before launch) -------------------------------
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@caryo.example.com

# --- Google OAuth (optional — social login disabled when empty) -------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sentry (recommended — error reporting stays off when empty) ------------
SENTRY_DSN=
