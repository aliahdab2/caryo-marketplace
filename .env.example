# ========================================
# Caryo Marketplace - Environment Variables Template
# ========================================
# CRITICAL SECURITY INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace ALL REPLACE_WITH_* values with actual secrets
# 3. NEVER commit .env files to version control
# 4. Use DIFFERENT secrets for dev/staging/production environments
# 5. Store production secrets in a secure secrets manager
# ========================================

# ============================================
# JWT Configuration
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=jdbc:postgresql://localhost:5432/caryo_db
DATABASE_USERNAME=caryo_user
DATABASE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ============================================
# MinIO/S3 Storage Configuration
# ============================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_SECRET_KEY
MINIO_BUCKET_NAME=caryo-uploads
MINIO_REGION=us-east-1

# ============================================
# OpenAI Configuration (for translations)
# ============================================
# CRITICAL: If you previously committed an API key, REVOKE IT IMMEDIATELY
# Go to: https://platform.openai.com/api-keys
# 1. Revoke the exposed key
# 2. Generate a new key
# 3. Set it here (NEVER commit this file with real keys)
OPENAI_API_KEY=REPLACE_WITH_YOUR_NEW_OPENAI_KEY

# ============================================
# CORS Configuration
# ============================================
# SECURITY WARNING:
# - Development: Use http://localhost:3000,http://localhost:3001
# - Production: Use HTTPS ONLY (https://caryo.sy,https://www.caryo.sy)
# - NEVER use wildcards (*) in production
# - NEVER mix HTTP and HTTPS in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Production example (replace with your actual domains):
# CORS_ALLOWED_ORIGINS=https://caryo.sy,https://www.caryo.sy,https://api.caryo.sy

# ============================================
# Google OAuth Configuration
# ============================================
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2/callback/google

# ============================================
# Email Configuration
# ============================================
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@caryo.sy
EMAIL_SUPPORT=support@caryo.sy
EMAIL_ADMIN=admin@caryo.sy

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true

# ============================================
# Application URLs
# ============================================
WEBSITE_NAME=Caryo
WEBSITE_NAME_AR=كاريو
WEBSITE_URL=http://localhost:3000
WEBSITE_SUPPORT_EMAIL=support@caryo.sy
WEBSITE_SUPPORT_PHONE=+963-XXX-XXXX

# ============================================
# Password Reset Configuration
# ============================================
PASSWORD_RESET_TOKEN_EXPIRY=86400
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

# ============================================
# Newsletter Configuration
# ============================================
NEWSLETTER_ENABLED=true
NEWSLETTER_CONFIRMATION_URL=http://localhost:3000/newsletter/confirm
NEWSLETTER_UNSUBSCRIBE_URL=http://localhost:3000/newsletter/unsubscribe

# ============================================
# Payment Configuration
# ============================================
# PayPal
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_SUCCESS_URL=http://localhost:3000/payment/success
PAYPAL_CANCEL_URL=http://localhost:3000/payment/cancel

# Stripe
STRIPE_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel
STRIPE_PRICE_BASIC=price_basic_monthly
STRIPE_PRICE_ADVANCED=price_advanced_monthly
STRIPE_PRICE_PROFESSIONAL=price_professional_monthly

# Manual Bank Transfer
BANK_NAME=Cham Bank
BANK_ACCOUNT=123456789
BANK_ACCOUNT_NAME=Caryo Marketplace
BANK_IBAN=SY12345678901234567890
BANK_SWIFT=CHAMSYNX
BANK_BRANCH=Damascus Main Branch

# ============================================
# Frontend Configuration (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_STRING

# Feature Flags
NEXT_PUBLIC_VIDEO_UPLOAD_ENABLED=true
NEXT_PUBLIC_VIDEO_URL_ENABLED=true

# ============================================
# Production-Only Settings
# ============================================
# Uncomment and configure for production

# AWS/Cloud Configuration
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=

# Monitoring
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Analytics
# GOOGLE_ANALYTICS_ID=

# ========================================
# PRODUCTION SECURITY CHECKLIST
# ========================================
# Before deploying to production, verify:
#
# CRITICAL (Do these FIRST):
# [ ] Revoked any previously exposed OpenAI API key
# [ ] Generated new JWT_SECRET with: openssl rand -base64 64
# [ ] Generated strong DATABASE_PASSWORD with: openssl rand -base64 32
# [ ] Generated MINIO_ACCESS_KEY with: openssl rand -hex 20
# [ ] Generated MINIO_SECRET_KEY with: openssl rand -base64 32
# [ ] Created new OpenAI API key (after revoking old one)
#
# CORS & URLs:
# [ ] Set CORS_ALLOWED_ORIGINS to production domains ONLY (HTTPS)
# [ ] Updated all *_URL variables to use HTTPS
# [ ] Verified no localhost URLs in production config
#
# Credentials:
# [ ] Configured Google OAuth with production redirect URI
# [ ] Set up SMTP email credentials (use app-specific passwords)
# [ ] Configured payment provider credentials (if enabled)
#
# Infrastructure:
# [ ] Verified .env is in .gitignore and NOT in git repository
# [ ] Stored production .env in secure location (vault/secrets manager)
# [ ] Set up SSL/TLS certificates for HTTPS
# [ ] Configured firewall rules
#
# Monitoring & Backup:
# [ ] Configured error tracking (Sentry recommended)
# [ ] Set up uptime monitoring
# [ ] Configured database backups
# [ ] Set up log aggregation
#
# Testing:
# [ ] Tested rate limiting on auth endpoints
# [ ] Verified CORS blocks unauthorized origins
# [ ] Tested XSS prevention in messaging
# [ ] Verified file upload restrictions
# [ ] Tested authentication flow end-to-end
#
# Documentation:
# [ ] Reviewed docs/SECURITY_QUICK_START.md
# [ ] Reviewed docs/SECURITY_CONFIGURATION.md
# [ ] Documented incident response plan
# [ ] Documented backup restoration process
# ========================================
