{
  "name": "frontend",
  "version": "0.1.0",
  "description": "Caryo Marketplace",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:check": "npm run type-check && npm run lint && npm run build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "lint:all": "eslint .",
    "prepare": "husky",
    "test": "node --no-deprecation ./node_modules/.bin/jest",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:report": "npx playwright show-report",
    "restart": "sh ./scripts/restart-dev.sh",
    "diagnose": "node ./scripts/diagnostics/simple-diagnostics.js",
    "translation": "node ./scripts/translation-tools/cli/index.js",
    "translation:validate": "node ./scripts/translation-tools/core/validator-refactored.js summary",
    "translation:summary": "node ./scripts/translation-tools/core/validator-refactored.js summary",
    "translation:detailed": "node ./scripts/translation-tools/core/validator-refactored.js detailed",
    "translation:missing": "node ./scripts/translation-tools/core/validator-refactored.js missing",
    "translation:duplicates": "node ./scripts/translation-tools/core/validator-refactored.js duplicates",
    "translation:fix-duplicates": "node ./scripts/translation-tools/core/validator-refactored.js fix-duplicates",
    "translation:orphaned": "node ./scripts/translation-tools/core/validator-refactored.js orphaned",
    "translation:orphaned-safe": "node ./scripts/translation-tools/core/validator-refactored.js orphaned-safe",
    "translation:remove-orphaned": "node ./scripts/translation-tools/core/validator-refactored.js remove-orphaned",
    "translation:incomplete": "node ./scripts/translation-tools/core/validator-refactored.js incomplete",
    "translation:verify-needs": "node ./scripts/translation-tools/core/verify-needs.js",
    "translation:export": "node ./scripts/translation-tools/core/validator-refactored.js export",
    "translation:export-missing": "node ./scripts/translation-tools/core/validator-refactored.js export-missing",
    "translation:sync-check": "node ./scripts/translation-tools/analysis/sync-check.js",
    "translation:unused": "node ./scripts/translation-tools/core/validator-refactored.js orphaned",
    "translation:scan": "node ./scripts/translation-tools/core/validator-refactored.js detailed",
    "translation:usage-analysis": "node ./scripts/translation-tools/core/validator-refactored.js detailed",
    "translation:test": "node ./scripts/translation-tools/core/modules/__tests__/run-tests.js",
    "translation:test:duplicates": "npx jest ./scripts/translation-tools/core/modules/__tests__/duplicates.test.js",
    "translation:test:loader": "npx jest ./scripts/translation-tools/core/modules/__tests__/loader.test.js",
    "translation:test:utils": "npx jest ./scripts/translation-tools/core/modules/__tests__/utils.test.js",
    "translation:fix-guide": "node ./scripts/translation-tools/fixes/guide-fixer.js",
    "translation:maintenance": "node ./scripts/translation-tools/workflow/maintenance.js",
    "sitemap": "next-sitemap"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@octokit/rest": "^22.0.1",
    "@sentry/nextjs": "^10.38.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.91.3",
    "axios": "^1.11.0",
    "dompurify": "^3.2.6",
    "eslint-config-next": "^16.1.6",
    "framer-motion": "^12.26.2",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-http-backend": "^3.0.2",
    "lodash-es": "^4.17.23",
    "lucide-react": "^0.511.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.11",
    "next-sitemap": "^4.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.4.6",
    "@playwright/test": "^1.58.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^29.5.12",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.7",
    "node-fetch": "^2.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "whatwg-fetch": "^3.6.20"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
