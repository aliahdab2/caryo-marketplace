        {
          "name": "Submit Contact Form - Large Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response status is 200 or 400', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "",
                  "pm.test('Large message handled appropriately', function () {",
                  "    if (pm.response.code === 200) {",
                  "        const responseJson = pm.response.json();",
                  "        pm.expect(responseJson).to.have.property('message');",
                  "        pm.expect(responseJson.message).to.include('Thank you for your message');",
                  "    } else if (pm.response.code === 400) {",
                  "        const responseJson = pm.response.json();",
                  "        pm.expect(responseJson).to.have.property('message');",
                  "        pm.expect(responseJson.message).to.include('Validation failed');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"subject\": \"Long inquiry about multiple car listings\",\n    \"message\": \"{{ 'This is a very long message. '.repeat(100) }}I would like to know more about multiple car listings on your platform. Could you provide detailed information about the BMW X5, Mercedes C-Class, and Audi A4 listings? I am particularly interested in their mileage, service history, and any available warranties. Please also let me know about financing options and trade-in possibilities.\"\n}"
            },
