		{
			"name": "8. Test Media Reordering",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Create a new listing for media reorder testing",
							"const createListingRequest = {",
							"  url: pm.environment.get('base_url') + '/api/listings',",
							"  method: 'POST',",
							"  header: {",
							"    'Content-Type': 'application/json',",
							"    'Authorization': 'Bearer ' + pm.environment.get('admin_token')",
							"  },",
							"  body: {",
							"    mode: 'raw',",
							"    raw: JSON.stringify({",
							"      title: 'Media Reorder Test Listing',",
							"      modelId: 1,",
							"      transmissionId: 1,",
							"      fuelTypeId: 1,",
							"      bodyStyleId: 1,",
							"      modelYear: 2023,",
							"      price: 30000,",
							"      currency: 'USD',",
							"      mileage: 15000,",
							"      locationId: 1,",
							"      description: 'Test listing for media reordering',",
							"      contactName: 'Test User',",
							"      contactEmail: 'test@example.com',",
							"      contactPhone: '+1-555-123-4567',",
							"      contactPreference: 'email'",
							"    })",
							"  }",
							"};",
							"",
							"pm.sendRequest(createListingRequest, function (err, response) {",
							"  if (err) {",
							"    console.log('Error creating test listing:', err);",
							"  } else {",
							"    const listing = response.json();",
							"    pm.environment.set('reorder_test_listing_id', listing.id);",
							"    console.log('Created test listing with ID:', listing.id);",
							"    ",
							"    // Upload multiple images to test reordering",
							"    // Note: In a real test, you'd upload actual images",
							"    // For this test, we'll simulate having media items",
							"  }",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Media reorder endpoint exists\", function () {",
							"    // This test verifies the endpoint is available",
							"    // In practice, you'd need actual media items to reorder",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 400, 404]);",
							"});",
							"",
							"pm.test(\"Response format is correct\", function () {",
							"    if (pm.response.code === 200) {",
							"        const response = pm.response.json();",
							"        pm.expect(response).to.have.property('id');",
							"    } else if (pm.response.code === 400) {",
							"        const response = pm.response.json();",
							"        pm.expect(response).to.have.property('message');",
							"    }",
							"});",
							"",
							"// Cleanup: Delete the test listing",
							"const deleteRequest = {",
							"  url: pm.environment.get('base_url') + '/api/listings/' + pm.environment.get('reorder_test_listing_id'),",
							"  method: 'DELETE',",
							"  header: {",
							"    'Authorization': 'Bearer ' + pm.environment.get('admin_token')",
							"  }",
							"};",
							"",
							"pm.sendRequest(deleteRequest, function (err, response) {",
							"  if (!err) {",
							"    console.log('Cleaned up test listing');",
							"  }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "[\n  {\n    \"id\": 1,\n    \"sortOrder\": 1\n  },\n  {\n    \"id\": 2,\n    \"sortOrder\": 0\n  }\n]"
				},
				"url": {
					"raw": "{{base_url}}/api/listings/{{reorder_test_listing_id}}/media/order",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"listings",
						"{{reorder_test_listing_id}}",
						"media",
						"order"
					]
				},
				"description": "Tests the media reordering endpoint with sample data. Note: This test may return 400 if no media items exist with the specified IDs."
			},
			"response": []
		}
	],
