{
  "info": {
    "name": "Saved Searches API Tests",
    "description": "Test collection for Saved Search functionality",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup - Register Test User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const randomUsername = 'savedsearch_user_' + Math.random().toString(36).substring(2, 10);",
              "const randomEmail = `${randomUsername}@example.com`;",
              "",
              "pm.environment.set('saved_search_test_username', randomUsername);",
              "pm.environment.set('saved_search_test_email', randomEmail);",
              "pm.environment.set('saved_search_test_password', 'password123');",
              "",
              "console.log(`Generated saved search test user: ${randomUsername}, ${randomEmail}`);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Registration successful message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include(\"successfully\");",
              "});",
              "",
              "console.log(\"Saved Search User Registration Response:\", pm.response.json());"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{saved_search_test_username}}\",\n    \"email\": \"{{saved_search_test_email}}\",\n    \"password\": \"{{saved_search_test_password}}\",\n    \"role\": [\"user\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "signup"]
        }
      }
    },
    {
      "name": "Setup - Login Test User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has access token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.token).to.exist;",
              "    pm.expect(jsonData.type).to.equal(\"Bearer\");",
              "    ",
              "    pm.environment.set(\"saved_search_auth_token\", jsonData.token);",
              "});",
              "",
              "console.log(\"Saved Search User Login Response:\", pm.response.json());",
              "console.log(\"Saved Search Auth Token:\", pm.environment.get(\"saved_search_auth_token\") ? (pm.environment.get(\"saved_search_auth_token\").substring(0, 15) + \"...\") : \"none\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"{{saved_search_test_username}}\",\n    \"password\": \"{{saved_search_test_password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/signin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "signin"]
        }
      }
    },
