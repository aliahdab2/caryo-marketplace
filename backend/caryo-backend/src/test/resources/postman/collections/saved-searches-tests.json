    {
      "name": "Create Saved Search - Toyota Under 30k",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('name');",
              "    pm.expect(jsonData).to.have.property('description');",
              "    pm.expect(jsonData).to.have.property('filters');",
              "    pm.expect(jsonData).to.have.property('notificationsEnabled');",
              "    pm.expect(jsonData).to.have.property('emailNotifications');",
              "    pm.expect(jsonData).to.have.property('isActive');",
              "    pm.expect(jsonData).to.have.property('createdAt');",
              "    pm.expect(jsonData).to.have.property('updatedAt');",
              "    ",
              "    pm.environment.set('saved_search_id_1', jsonData.id);",
              "});",
              "",
              "pm.test(\"Saved search data matches request\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.equal('Toyota Under 30k');",
              "    pm.expect(jsonData.description).to.equal('Looking for Toyota cars under $30,000');",
              "    pm.expect(jsonData.notificationsEnabled).to.be.true;",
              "    pm.expect(jsonData.emailNotifications).to.be.true;",
              "    pm.expect(jsonData.isActive).to.be.true;",
              "    pm.expect(jsonData.filters.brandSlugs).to.include('toyota');",
              "    pm.expect(jsonData.filters.maxPrice).to.equal(30000);",
              "});",
              "",
              "console.log(\"Created saved search:\", pm.response.json());"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{saved_search_auth_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Toyota Under 30k\",\n    \"description\": \"Looking for Toyota cars under $30,000\",\n    \"filters\": {\n        \"brandSlugs\": [\"toyota\"],\n        \"maxPrice\": 30000,\n        \"minYear\": 2015\n    },\n    \"notificationsEnabled\": true,\n    \"emailNotifications\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/saved-searches",
          "host": ["{{baseUrl}}"],
          "path": ["api", "saved-searches"]
        }
      }
    },
