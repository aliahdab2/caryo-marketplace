    {
      "name": "Update Saved Search",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Saved search was updated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.equal('Updated Toyota Search');",
              "    pm.expect(jsonData.description).to.equal('Looking for newer Toyota cars');",
              "    pm.expect(jsonData.filters.minYear).to.equal(2018);",
              "    pm.expect(jsonData.filters.maxPrice).to.equal(35000);",
              "    pm.expect(jsonData.emailNotifications).to.be.false;",
              "});",
              "",
              "pm.test(\"Updated timestamp changed\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.updatedAt).to.exist;",
              "    pm.expect(jsonData.createdAt).to.not.equal(jsonData.updatedAt);",
              "});",
              "",
              "console.log(\"Updated saved search:\", pm.response.json());"
            ],
            "type": "text/javascript"
          }
        }
