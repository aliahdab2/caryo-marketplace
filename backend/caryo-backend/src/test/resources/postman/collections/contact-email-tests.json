{
	"info": {
		"_postman_id": "email-contact-tests",
		"name": "Contact Email Tests",
		"description": "Test contact form email functionality",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Test Contact Form - English",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has success status\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"});",
							"",
							"pm.test(\"Response has thank you message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.include(\"Thank you\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"message\": \"I am interested in learning more about your car marketplace.\",\n    \"language\": \"en\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/contact",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"contact"
					]
				}
			},
			"response": []
		},
		{
			"name": "Test Contact Form - Arabic",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has success status\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"success\");",
							"});",
							"",
							"pm.test(\"Response has Arabic thank you message\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.include(\"شكراً\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"أحمد محمد\",\n    \"email\": \"ahmed@example.com\",\n    \"message\": \"أود معرفة المزيد عن سوق السيارات الخاص بكم.\",\n    \"language\": \"ar\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/contact",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"contact"
					]
				}
			},
			"response": []
		},
		{
			"name": "Test Contact Form - Missing Fields",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 400 for invalid data\", function () {",
							"    pm.response.to.have.status(400);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"\",\n    \"email\": \"invalid-email\",\n    \"message\": \"\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/contact",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"contact"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		}
	]
}