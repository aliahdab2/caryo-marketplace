  "item": [
    {
      "name": "Create Conversation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('listingId');",
              "    pm.expect(jsonData).to.have.property('buyer');",
              "    pm.expect(jsonData).to.have.property('seller');",
              "    pm.expect(jsonData).to.have.property('status');",
              "});",
              "",
              "pm.test(\"Conversation created successfully message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include('successfully');",
              "});",
              "",
              "// Store conversation ID for subsequent tests",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.environment.set('conversation_id', jsonData.id);",
              "    console.log('Created conversation with ID:', jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"listingId\": 1,\n  \"initialMessage\": \"I'm interested in this car\",\n  \"subject\": \"Car Inquiry\",\n  \"messageType\": \"text\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/conversations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "conversations"
          ]
        }
      }
    },
    {
      "name": "Get User Conversations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is paginated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('content');",
              "    pm.expect(jsonData).to.have.property('totalElements');",
              "    pm.expect(jsonData).to.have.property('totalPages');",
              "    pm.expect(jsonData).to.have.property('currentPage');",
              "});",
              "",
              "pm.test(\"Conversations have required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.content && jsonData.content.length > 0) {",
              "        var conversation = jsonData.content[0];",
              "        pm.expect(conversation).to.have.property('id');",
              "        pm.expect(conversation).to.have.property('listingTitle');",
              "        pm.expect(conversation).to.have.property('buyer');",
              "        pm.expect(conversation).to.have.property('seller');",
              "        pm.expect(conversation).to.have.property('lastMessageAt');",
              "        pm.expect(conversation).to.have.property('unreadCount');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/conversations/my-conversations?page=0&size=10&sort=lastMessageAt&direction=desc",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "conversations",
            "my-conversations"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            },
            {
              "key": "sort",
              "value": "lastMessageAt"
            },
            {
              "key": "direction",
              "value": "desc"
            }
          ]
        }
      }
    },
