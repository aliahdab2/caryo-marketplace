    {
      "name": "Upload Message Attachment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Attachment uploaded successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('fileUrl');",
              "    pm.expect(jsonData).to.have.property('fileName');",
              "    pm.expect(jsonData).to.have.property('contentType');",
              "    pm.expect(jsonData).to.have.property('size');",
              "    pm.expect(jsonData).to.have.property('attachmentId');",
              "    pm.expect(jsonData.message).to.include('successfully');",
              "});",
              "",
              "// Store attachment info for subsequent tests",
              "var jsonData = pm.response.json();",
              "if (jsonData.attachmentId) {",
              "    pm.environment.set('attachment_id', jsonData.attachmentId);",
              "    console.log('Uploaded attachment with ID:', jsonData.attachmentId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
