              "key": "content",
              "value": "Please find the car documents attached.",
              "type": "text"
            },
            {
              "key": "messageType",
              "value": "document",
              "type": "text"
            },
            {
              "key": "files",
              "type": "file",
              "src": "test-file.pdf"
            }
          ]
        },
        "url": {
