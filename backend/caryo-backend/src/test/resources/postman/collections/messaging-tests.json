    {
      "name": "Send Message with Attachments",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Message with attachments created successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('conversationId');",
              "    pm.expect(jsonData).to.have.property('content');",
              "    pm.expect(jsonData).to.have.property('messageType');",
              "    pm.expect(jsonData).to.have.property('attachments');",
              "    pm.expect(jsonData.message).to.include('successfully');",
              "});",
              "",
              "pm.test(\"Attachments are properly included\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.attachments && jsonData.attachments.length > 0) {",
              "        var attachment = jsonData.attachments[0];",
              "        pm.expect(attachment).to.have.property('id');",
              "        pm.expect(attachment).to.have.property('fileName');",
              "        pm.expect(attachment).to.have.property('contentType');",
              "        pm.expect(attachment).to.have.property('fileUrl');",
              "        pm.expect(attachment).to.have.property('uploadStatus');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
